allow init proc_last_kmsg:file {
  r_file_perms
  setattr
};


# Allow init to set attribute to sysfs_kprofiles
allow init sysfs_kprofiles:file { setattr };

set_prop(init, vendor_fingerprint_prop)

allow init vendor_sysfs_battery_supply:file { open read getattr setattr};
allow init vendor_sysfs_fastcharge:file { setattr };
