allow devicesettings_app vendor_sysfs_graphics:dir search;
allow devicesettings_app sysfs_display:file { open write getattr };

# Allow xiaomiparts to read and write to vendor_sysfs_graphics
r_dir_file(devicesettings_app, vendor_sysfs_graphics)

allow devicesettings_app vendor_sysfs_fastcharge:file { getattr open read write };
allow devicesettings_app vendor_sysfs_battery_supply:file { getattr open read write };

allow devicesettings_app vendor_sysfs_battery_supply:dir { search };

# Allow charging bypass to overwrite
allow devicesettings_app sysfs_battery_writable:dir r_dir_perms;
allow devicesettings_app sysfs_battery_writable:file { open read write getattr ioctl };
