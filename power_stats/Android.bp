/*
 */

// Xiaomi Stats AIDL Service
cc_binary {
    name: "android.hardware.power.stats-service.default",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.power.stats-service.default.rc"],
    vintf_fragments: ["android.hardware.power.stats-service.default.xml"],
    srcs: [
        "service.cpp",
        "Stats.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "android.hardware.power.stats-V2-ndk",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-DLOG_TAG=\"PowerStatsXiaomi\"",
    ],
}
