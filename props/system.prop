# Camera
ro.camerax.extensions.enabled=true

# Charger
ro.charger.enable_suspend=1

# Dalvik
dalvik.vm.systemservercompilerfilter=speed 
dalvik.vm.systemuicompilerfilter=speed 

# Display
debug.gralloc.gfx_ubwc_disable=0
persist.vendor.color.matrix=2
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
debug.sf.predict_hwc_composition_strategy=0


# Disable Skia tracing by default
debug.hwui.skia_tracing_enabled=false
debug.hwui.skia_use_perfetto_track_events=false



# Deep Sleep
vendor.post_boot.parsed=1s

# Feature flags
persist.sys.fflag.override.settings_enable_monitor_phantom_procs=false

# IMS
persist.radio.VT_HYBRID_ENABLE=1
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1

# IMS Debugging
persist.vendor.ims.disableADBLogs=1
persist.vendor.ims.disableDebugLogs=1
persist.vendor.ims.disableIMSLogs=1
persist.vendor.ims.disableQXDMLogs=1

# IOP
#vendor.iop.enable_prefetch_ofr=1
#vendor.iop.enable_uxe=1




# RIL
persist.sys.fflag.override.settings_provider_model=false
persist.vendor.radio.report_codec=1
ril.subscription.types=NV,RUIM


# RmNet Data
persist.rmnet.data.enable=true
persist.data.wda.enable=true
persist.data.df.dl_mode=5
persist.data.df.ul_mode=5
persist.data.df.agg.dl_pkt=10
persist.data.df.agg.dl_size=4096
persist.data.df.mux_count=8
persist.data.df.iwlan_mux=9
persist.data.df.dev_name=rmnet_usb0

# Thermal
vendor.sys.thermal.data.path=/data/vendor/thermal/

# Vendor
ro.vendor.qti.va_aosp.support=1

# BT audio
audio.offload.buffer.size.kb=256
audio.offload.gapless.enabled=true

#LMK
ro.config.low_ram=false
ro.vendor.lmk.force_inkernel_lmk=false



