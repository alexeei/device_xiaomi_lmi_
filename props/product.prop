# Audio
af.fast_track_multiplier=1
audio.deep_buffer.media=true
audio.offload.min.duration.secs=30
audio.offload.video=true
ro.af.client_heap_size_kbyte=7168

# FUSE passthrough
persist.sys.fuse.passthrough.enable=true

# Memory management
persist.sys.fw.bg_apps_limit=64
#persist.sys.fw.empty_app_percent?=50

# LMK
#ro.lmk.kill_heaviest_task=true
ro.config.low_ram=false
ro.vendor.lmk.force_inkernel_lmk=true
#ro.lmk.kill_timeout_ms=100
#ro.lmk.thrashing_limit=50
#ro.lmk.thrashing_limit_decay=25
#ro.lmk.swap_free_low_percentage=10
#ro.lmk.psi_partial_stall_ms=50
#ro.lmk.psi_complete_stall_ms=80
#ro.lmk.use_new_strategy=true
#ro.lmk.psi_scrit_complete_stall_ms=75
#ro.lmk.nstrat_wmark_boost_factor=4
#ro.lmk.direct_reclaim_pressure=45
#ro.lmk.reclaim_scan_threshold=0
#ro.lmk.enable_watermark_check=true
ro.lmk.enable_userspace_lmk=false
#ro.lmk.enhance_batch_kill=false
#ro.lmk.super_critical=701

